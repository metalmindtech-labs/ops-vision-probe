// prisma/course_jobs.prisma.snippet
// Merge this model into your existing schema.prisma, then `npx prisma migrate dev`.
// Using a different ORM? Map these columns 1:1.

model CourseJob {
  id              String   @id                 // "lf_job_<uuid>"
  idempotencyKey  String   @unique @map("idempotency_key")
  signalId        String   @map("signal_id")
  correlationId   String   @map("correlation_id")
  status          String   @default("accepted") // accepted|queued|generating|reviewing|ready|failed
  publicCourseUrl String?  @map("public_course_url")
  error           String?
  brief           Json                          // the full CourseBriefV2 as received
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([signalId])
  @@map("course_jobs")
}
